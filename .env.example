# Copy to `.env` (git-ignored) and fill in. `npm start` / `npm run build` turn the two
# SUPABASE_* app settings into src/environments/supabase.env.ts (also git-ignored).

# --- App (Supabase -> Project Settings -> API). PUBLISHABLE key only. ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Local admin scripts only (npm run setup:users). NEVER used by the app. ---
# Secret key: Project Settings -> API Keys -> Secret keys. Delete it again when done.
SUPABASE_SECRET_KEY=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Optional password for `npm run setup:users -- --demo` accounts (defaults to ADMIN_PASSWORD)
DEMO_PASSWORD=
