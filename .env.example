# Copy to `.env` (git-ignored) and fill in. Read by src/server.ts for both `npm start` and production.
# In production, set these as real environment variables on your host instead of using a file.

# Base URL of your InvenTree server (no trailing /api)
INVENTREE_URL=https://inventree.example.com

# API token of a dedicated, read-only InvenTree user (Settings -> Account -> Access Tokens)
INVENTREE_TOKEN=inv-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-00000000
